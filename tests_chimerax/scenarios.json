 {
  "id": "which-chain",
  "category": "edge",
  "setup_commands": [
   "open 4hhb"
  ],
  "request": "show only chain B",
  "expected": "chain B shown, others hidden",
  "check_type": "state_expr",
  "check": "any(re.search('hide|~', c) for c in ran) and any(re.search('/B', c) for c in ran)"
 },
 {
  "id": "multi-step",
  "category": "multi",
  "setup_commands": [
   "open 4hhb"
  ],
  "request": "color chain A blue, chain B red, hide the water, show the heme as sticks and set a white background",
  "expected": "all five actions",
  "check_type": "state_expr",
  "check": "min(bg) > 0.95 and not any(a.display for a in atoms if a.residue.name == 'HOH') and any(a.display for a in atoms if a.residue.name == 'HEM') and all(tuple(a.color[:3])==(0,0,255) for a in atoms if a.residue.chain_id=='A' and a.name=='CA')"
 },
 {
  "id": "gene-lookup",
  "category": "open",
  "setup_commands": [],
  "request": "open the af model for the gene adrb2 and color it white",
  "expected": "resolve_protein then open alphafold:P07550",
  "check_type": "state_expr",
  "check": "any('P07550' in m.name.upper() for m in models) and ('resolve_protein' in [c[0] for c in record['calls']])"
 },
