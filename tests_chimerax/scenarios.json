[
 {
  "id": "color-chain",
  "category": "color",
  "setup_commands": [
   "open 4hhb"
  ],
  "request": "color by chain",
  "expected": "chains get distinct colors",
  "check_type": "state_expr",
  "check": "len(set(tuple(a.color) for a in atoms if a.name=='CA')) >= 4"
 },
 {
  "id": "color-residue",
  "category": "color",
  "setup_commands": [
   "open 1zik"
  ],
  "request": "color everything white but make residue 10 blue",
  "expected": "residue 10 blue, rest white",
  "check_type": "state_expr",
  "check": "all(tuple(a.color[:3])==(0,0,255) for a in atoms if a.residue.number==10 and a.name=='CA') and all(tuple(a.color[:3])==(255,255,255) for a in atoms if a.residue.number==20 and a.name=='CA')"
 },
 {
  "id": "hide-atoms",
  "category": "display",
  "setup_commands": [
   "open 1zik",
   "show atoms"
  ],
  "request": "hide the atoms",
  "expected": "no atoms displayed",
  "check_type": "state_expr",
  "check": "not atoms.displays.any()"
 },
 {
  "id": "show-atoms",
  "category": "display",
  "setup_commands": [
   "open 1zik",
   "hide atoms"
  ],
  "request": "show all the atoms",
  "expected": "atoms displayed",
  "check_type": "state_expr",
  "check": "atoms.displays.sum() > 100"
 },
 {
  "id": "select-residues",
  "category": "select",
  "setup_commands": [
   "open 1zik"
  ],
  "request": "select amino acids 10 15 and 20 and show their atoms",
  "expected": "residues 10,15,20 selected and shown",
  "check_type": "state_expr",
  "check": "set(sel_res) == {10, 15, 20}"
 },
 {
  "id": "select-typos",
  "category": "select",
  "setup_commands": [
   "open 1zik"
  ],
  "request": "select amono acids 5 and 25 and mesure the distance between them",
  "expected": "distance measured between residues 5 and 25",
  "check_type": "state_expr",
  "check": "any(m.__class__.__name__ == 'PseudobondGroup' and m.num_pseudobonds > 0 for m in models)"
 },
 {
  "id": "distance",
  "category": "measure",
  "setup_commands": [
   "open 1zik"
  ],
  "request": "measure the distance between residue 10 and residue 20",
  "expected": "a distance pseudobond exists",
  "check_type": "state_expr",
  "check": "any(m.__class__.__name__ == 'PseudobondGroup' and m.num_pseudobonds > 0 for m in models)"
 },
 {
  "id": "spin",
  "category": "motion",
  "setup_commands": [
   "open 1zik"
  ],
  "request": "make it spin",
  "expected": "roll or turn command",
  "check_type": "commands_regex",
  "check": "^(roll|turn)\\b"
 },
 {
  "id": "spin-stop",
  "category": "motion",
  "setup_commands": [
   "open 1zik"
  ],
  "request": "make it spin",
  "followups": [
   "stop it"
  ],
  "expected": "stop command issued",
  "check_type": "commands_regex",
  "check": "^stop\\b"
 },
 {
  "id": "background",
  "category": "view",
  "setup_commands": [
   "open 1zik"
  ],
  "request": "color the bacground grey",
  "expected": "background gray",
  "check_type": "state_expr",
  "check": "abs(bg[0]-bg[1]) < 0.05 and 0.3 < bg[0] < 0.75"
 },
 {
  "id": "background-white",
  "category": "view",
  "setup_commands": [
   "open 1zik"
  ],
  "request": "white background please",
  "expected": "background white",
  "check_type": "state_expr",
  "check": "min(bg) > 0.95"
 },
 {
  "id": "publication",
  "category": "view",
  "setup_commands": [
   "open 4hhb"
  ],
  "request": "make it look publiction ready",
  "expected": "preset/lighting/silhouettes applied",
  "check_type": "commands_regex",
  "check": "preset|lighting|silhouette"
 },
 {
  "id": "focus",
  "category": "view",
  "setup_commands": [
   "open 1zik"
  ],
  "request": "focos on residue 15",
  "expected": "view command on residue 15",
  "check_type": "commands_regex",
  "check": "(^view\\b.*\\b15\\b)|(^select\\b.*\\b15\\b)"
 },
 {
  "id": "reset-view",
  "category": "view",
  "setup_commands": [
   "open 1zik",
   "view :10"
  ],
  "request": "reset the view",
  "expected": "view with no args",
  "check_type": "commands_regex",
  "check": "^view\\s*$"
 },
 {
  "id": "labels",
  "category": "label",
  "setup_commands": [
   "open 1zik"
  ],
  "request": "label residues 10 and 20",
  "expected": "label command",
  "check_type": "commands_regex",
  "check": "^label\\b"
 },
 {
  "id": "transparency",
  "category": "display",
  "setup_commands": [
   "open 1zik",
   "surface"
  ],
  "request": "make the surface half transparent",
  "expected": "transparency 50",
  "check_type": "commands_regex",
  "check": "^transparency\\b.*50"
 },
 {
  "id": "ligand-spheres",
  "category": "display",
  "setup_commands": [
   "open 4hhb"
  ],
  "request": "show the ligand as spheres and hide the water",
  "expected": "ligand shown as spheres, solvent hidden",
  "check_type": "state_expr",
  "check": "any(a.display and a.draw_mode == 0 for a in atoms if a.residue.name == 'HEM') and not any(a.display for a in atoms if a.residue.name == 'HOH')"
 },
 {
  "id": "cartoon-only",
  "category": "display",
  "setup_commands": [
   "open 4hhb",
   "show atoms"
  ],
  "request": "show only the cartoon",
  "expected": "atoms hidden (cartoon remains)",
  "check_type": "state_expr",
  "check": "not any(a.display for a in atoms if a.residue.name not in ('HEM','PO4'))"
 },
 {
  "id": "hbonds",
  "category": "analysis",
  "setup_commands": [
   "open 1zik"
  ],
  "request": "show hydrogen bonds",
  "expected": "hbonds pseudobonds",
  "check_type": "state_expr",
  "check": "any(m.name == 'hydrogen bonds' or (m.__class__.__name__ == 'PseudobondGroup' and m.num_pseudobonds > 0) for m in models)"
 },
